  "businessMethods": {
    "connectWallet": "Official user wallet session; no Solidity counterpart",
    "getGameState": "Game reads plus current Registry balance; Settled tier from the player's Claimed event",
    "getCollection": "Index NFT Transfer events and read tokenURI JSON; ERC721Enumerable is not implemented",
    "getRewardState": "Choice states + currentReward(tier); skip currentReward after ended()",
    "play": [
      "claimFree()",
      "burnForTier(uint256[])"
    ],
    "claimReward": "claimReward(uint256 minAmount): retain the user-approved minimum reward",
    "continueChallenge": "continueChallenge()",
    "getTokenBalance": "Token.balanceOf(address)",
    "quoteStars": "Game.quoteStars(uint256 quantity), read-only",
    "buyStars": "Game.buyStars(quantity,maxPayment) payable with exact quoted native BNB value; no ERC20 approval. Parse LP outcome separately.",
    "transferNFT": "NFT.safeTransferFrom(from,to,tokenId); .ai resolution uses the official wallet resolver"
  },
  "states": {
    "0": {
      "phase": "ready",
      "tier": 1
    },
    "1": {
      "phase": "choice",
      "tier": 1
    },
    "2": {
      "phase": "ready",
      "tier": 2
    },
    "3": {
      "phase": "choice",
      "tier": 2
    },
    "4": {
      "phase": "ready",
      "tier": 3
    },
    "5": {
      "phase": "choice",
      "tier": 3
    },
    "6": {
      "phase": "settled",
      "tierFrom": "Claimed.tier"
    }
  },
  "notes": {
    "resultRecovery": "No random Result event. Mint results use confirmed NFT Transfer and chain JSON. Burn results require confirmed calldata/burn logs plus pre-burn chain metadata or history because kind/tokenURI are removed.",
    "quotes": "quoteStars(quantity) has no wallet parameter. Wallet quota and identity eligibility require separate authoritative reads."
  }
